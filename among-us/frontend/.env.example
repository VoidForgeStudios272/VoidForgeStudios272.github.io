# Copy to .env and adjust if needed.
#
# LOCAL DEV (recommended): only set the proxy target. The browser uses same-origin
# requests; Vite forwards them to the backend — no CORS setup required.
VITE_PROXY_TARGET=http://localhost:3000

# PRODUCTION / direct backend (set at build time). API and Socket.IO share one server.
# VITE_BACKEND_URL=https://your-backend.example.com
# VITE_SOCKET_URL=https://your-backend.example.com

# VITE_DEBUG=true
